{
  "prefix": "cfdi",
  "xml-namespace": "https://www.sat.gob.mx/cfd/4",
  "xml-schemalocation": "https://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd",
  "version-attribute": "Version",
  "version-value": "4.0",
  "root-element": "Comprobante",
  "structure": {
    "attributes": [
      "Version",
      "Serie",
      "Folio",
      "Fecha",
      "Sello",
      "FormaPago",
      "NoCertificado",
      "Certificado",
      "CondicionesDePago",
      "SubTotal",
      "Descuento",
      "Moneda",
      "TipoCambio",
      "Total",
      "TipoDeComprobante",
      "Exportacion",
      "MetodoPago",
      "LugarExpedicion",
      "Confirmacion"
    ],
    "shortcuts": [
      {
        "path": [
          "Conceptos"
        ],
        "target": "Concepto",
        "multi": false
      },
      {
        "path": [
          "Impuestos",
          "Traslados"
        ],
        "target": "Traslado"
      },
      {
        "path": [
          "Impuestos",
          "Retenciones"
        ],
        "target": "Retencion"
      }
    ],
    "InformacionGlobal": {
      "attributes": [
        "Periodicidad",
        "Meses",
        "Año"
      ]
    },
    "CfdiRelacionados": {
      "attributes": [
        "TipoRelacion"
      ],
      "multiple": true,
      "CfdiRelacionado": {
        "attributes": [
          "UUID"
        ],
        "multiple": true
      }
    },
    "Emisor": {
      "attributes": [
        "Rfc",
        "Nombre",
        "RegimenFiscal",
        "FacAtrAdquirente"
      ]
    },
    "Receptor": {
      "attributes": [
        "Rfc",
        "Nombre",
        "DomicilioFiscalReceptor",
        "ResidenciaFiscal",
        "NumRegIdTrib",
        "RegimenFiscalReceptor",
        "UsoCFDI"
      ]
    },
    "Conceptos": {
      "Concepto": {
        "attributes": [
          "ClaveProdServ",
          "NoIdentificacion",
          "Cantidad",
          "ClaveUnidad",
          "Unidad",
          "Descripcion",
          "ValorUnitario",
          "Importe",
          "Descuento",
          "ObjetoImp"
        ],
        "multiple": true,
        "shortcuts": [
          {
            "path": [
              "Impuestos",
              "Traslados"
            ],
            "target": "Traslado"
          },
          {
            "path": [
              "Impuestos",
              "Retenciones"
            ],
            "target": "Retencion"
          }
        ],
        "ConceptoImpuestos": {
          "elementName": "Impuestos",
          "methodName": "Impuestos",
          "Traslados": {
            "Traslado": {
              "attributes": [
                "Base",
                "Impuesto",
                "TipoFactor",
                "TasaOCuota",
                "Importe"
              ],
              "multiple": true
            }
          },
          "Retenciones": {
            "Retencion": {
              "attributes": [
                "Base",
                "Impuesto",
                "TipoFactor",
                "TasaOCuota",
                "Importe"
              ],
              "multiple": true
            }
          }
        },
        "ACuentaTerceros": {
          "attributes": [
            "RfcACuentaTerceros",
            "NombreACuentaTerceros",
            "RegimenFiscalACuentaTerceros",
            "DomicilioFiscalACuentaTerceros"
          ]
        },
        "InformacionAduanera": {
          "attributes": [
            "NumeroPedimento"
          ],
          "multiple": true
        },
        "CuentaPredial": {
          "attributes": [
            "Numero"
          ],
          "multiple": true
        },
        "ComplementoConcepto": {
          "singleAddChild": true
        },
        "Parte": {
          "attributes": [
            "ClaveProdServ",
            "NoIdentificacion",
            "Cantidad",
            "Unidad",
            "Descripcion",
            "ValorUnitario",
            "Importe"
          ],
          "multiple": true,
          "InformacionAduanera": {
            "attributes": [
              "NumeroPedimento"
            ],
            "multiple": true
          }
        }
      }
    },
    "Impuestos": {
      "attributes": [
        "TotalImpuestosRetenidos",
        "TotalImpuestosTrasladados"
      ],
      "Retenciones": {
        "Retencion": {
          "attributes": [
            "Impuesto",
            "Importe"
          ],
          "multiple": true
        }
      },
      "Traslados": {
        "Traslado": {
          "attributes": [
            "Base",
            "Impuesto",
            "TipoFactor",
            "TasaOCuota",
            "Importe"
          ],
          "multiple": true
        }
      }
    },
    "Complemento": {
      "singleAddChild": true
    },
    "Addenda": {
      "singleAddChild": true
    }
  }
}

{
  "prefix": "cfdi",
  "xml-namespace": "https://www.sat.gob.mx/cfd/4",
  "xml-schemalocation": "https://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd",
  "version-attribute": "Version",
  "version-value": "4.0",
  "root": {
    "name": "Comprobante",
    "attributes": [
      "Version",
      "Serie",
      "Folio",
      "Fecha",
      "Sello",
      "FormaPago",
      "NoCertificado",
      "Certificado",
      "CondicionesDePago",
      "SubTotal",
      "Descuento",
      "Moneda",
      "TipoCambio",
      "Total",
      "TipoDeComprobante",
      "Exportacion",
      "MetodoPago",
      "LugarExpedicion",
      "Confirmacion"
    ],
    "shortcuts": [
      {
        "path": [
          "Conceptos"
        ],
        "target": "Concepto",
        "multi": false
      },
      {
        "path": [
          "Impuestos",
          "Traslados"
        ],
        "target": "Traslado"
      },
      {
        "path": [
          "Impuestos",
          "Retenciones"
        ],
        "target": "Retencion"
      }
    ],
    "children": [
      {
        "name": "InformacionGlobal",
        "attributes": [
          "Periodicidad",
          "Meses",
          "Año"
        ]
      },
      {
        "name": "CfdiRelacionados",
        "multiple": true,
        "attributes": [
          "TipoRelacion"
        ],
        "children": [
          {
            "name": "CfdiRelacionado",
            "multiple": true,
            "attributes": [
              "UUID"
            ]
          }
        ]
      },
      {
        "name": "Emisor",
        "attributes": [
          "Rfc",
          "Nombre",
          "RegimenFiscal",
          "FacAtrAdquirente"
        ]
      },
      {
        "name": "Receptor",
        "attributes": [
          "Rfc",
          "Nombre",
          "DomicilioFiscalReceptor",
          "ResidenciaFiscal",
          "NumRegIdTrib",
          "RegimenFiscalReceptor",
          "UsoCFDI"
        ]
      },
      {
        "name": "Conceptos",
        "children": [
          {
            "name": "Concepto",
            "multiple": true,
            "attributes": [
              "ClaveProdServ",
              "NoIdentificacion",
              "Cantidad",
              "ClaveUnidad",
              "Unidad",
              "Descripcion",
              "ValorUnitario",
              "Importe",
              "Descuento",
              "ObjetoImp"
            ],
            "shortcuts": [
              {
                "path": [
                  "Impuestos",
                  "Traslados"
                ],
                "target": "Traslado"
              },
              {
                "path": [
                  "Impuestos",
                  "Retenciones"
                ],
                "target": "Retencion"
              }
            ],
            "children": [
              {
                "name": "ConceptoImpuestos",
                "elementName": "Impuestos",
                "methodName": "Impuestos",
                "children": [
                  {
                    "name": "Traslados",
                    "children": [
                      {
                        "name": "Traslado",
                        "multiple": true,
                        "attributes": [
                          "Base",
                          "Impuesto",
                          "TipoFactor",
                          "TasaOCuota",
                          "Importe"
                        ]
                      }
                    ]
                  },
                  {
                    "name": "Retenciones",
                    "children": [
                      {
                        "name": "Retencion",
                        "multiple": true,
                        "attributes": [
                          "Base",
                          "Impuesto",
                          "TipoFactor",
                          "TasaOCuota",
                          "Importe"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "name": "ACuentaTerceros",
                "attributes": [
                  "RfcACuentaTerceros",
                  "NombreACuentaTerceros",
                  "RegimenFiscalACuentaTerceros",
                  "DomicilioFiscalACuentaTerceros"
                ]
              },
              {
                "name": "InformacionAduanera",
                "multiple": true,
                "attributes": [
                  "NumeroPedimento"
                ]
              },
              {
                "name": "CuentaPredial",
                "multiple": true,
                "attributes": [
                  "Numero"
                ]
              },
              {
                "name": "ComplementoConcepto",
                "singleAddChild": true
              },
              {
                "name": "Parte",
                "multiple": true,
                "attributes": [
                  "ClaveProdServ",
                  "NoIdentificacion",
                  "Cantidad",
                  "Unidad",
                  "Descripcion",
                  "ValorUnitario",
                  "Importe"
                ],
                "children": [
                  {
                    "name": "InformacionAduanera",
                    "multiple": true,
                    "attributes": [
                      "NumeroPedimento"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "Impuestos",
        "attributes": [
          "TotalImpuestosRetenidos",
          "TotalImpuestosTrasladados"
        ],
        "children": [
          {
            "name": "Retenciones",
            "children": [
              {
                "name": "Retencion",
                "multiple": true,
                "attributes": [
                  "Impuesto",
                  "Importe"
                ]
              }
            ]
          },
          {
            "name": "Traslados",
            "children": [
              {
                "name": "Traslado",
                "multiple": true,
                "attributes": [
                  "Base",
                  "Impuesto",
                  "TipoFactor",
                  "TasaOCuota",
                  "Importe"
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "Complemento",
        "singleAddChild": true
      },
      {
        "name": "Addenda",
        "singleAddChild": true
      }
    ]
  }
}

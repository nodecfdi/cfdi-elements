{
  "prefix": "plataformasTecnologicas",
  "xml-namespace": "http://www.sat.gob.mx/esquemas/retencionpago/1/PlataformasTecnologicas10",
  "xml-schemalocation": "http://www.sat.gob.mx/esquemas/retencionpago/1/PlataformasTecnologicas10/ServiciosPlataformasTecnologicas10.xsd",
  "version-attribute": "Version",
  "version-value": "1.0",
  "root": {
    "name": "ServiciosPlataformasTecnologicas",
    "attributes": [
      "Version",
      "Periodicidad",
      "NumServ",
      "MonTotServSIVA",
      "TotalIVATrasladado",
      "TotalIVARetenido",
      "TotalISRRetenido",
      "DifIVAEntregadoPrestServ",
      "MonTotalporUsoPlataforma",
      "MonTotalContribucionGubernamental"
    ],
    "children": [
      {
        "name": "Servicios",
        "children": [
          {
            "name": "DetallesDelServicio",
            "multiple": true,
            "attributes": [
              "FormaPagoServ",
              "TipoDeServ",
              "SubTipServ",
              "RFCTerceroAutorizado",
              "FechaServ",
              "PrecioServSinIVA"
            ],
            "children": [
              {
                "name": "ImpuestosTrasladadosdelServicio",
                "attributes": [
                  "Base",
                  "Impuesto",
                  "TipoFactor",
                  "TasaCuota",
                  "Importe"
                ]
              },
              {
                "name": "ContribucionGubernamental",
                "attributes": [
                  "ImpContrib",
                  "EntidadDondePagaLaContribucion"
                ]
              },
              {
                "name": "ComisionDelServicio",
                "attributes": [
                  "Base",
                  "Porcentaje",
                  "Importe"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}

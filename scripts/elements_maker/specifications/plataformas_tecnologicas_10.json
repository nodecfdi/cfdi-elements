{
  "prefix": "plataformasTecnologicas",
  "xml-namespace": "http://www.sat.gob.mx/esquemas/retencionpago/1/PlataformasTecnologicas10",
  "xml-schemalocation": "http://www.sat.gob.mx/esquemas/retencionpago/1/PlataformasTecnologicas10/ServiciosPlataformasTecnologicas10.xsd",
  "version-attribute": "Version",
  "version-value": "1.0",
  "root-element": "ServiciosPlataformasTecnologicas",
  "structure": {
    "attributes": [
      "Version",
      "Periodicidad",
      "NumServ",
      "MonTotServSIVA",
      "TotalIVATrasladado",
      "TotalIVARetenido",
      "TotalISRRetenido",
      "DifIVAEntregadoPrestServ",
      "MonTotalporUsoPlataforma",
      "MonTotalContribucionGubernamental"
    ],
    "Servicios": {
      "DetallesDelServicio": {
        "attributes": [
          "FormaPagoServ",
          "TipoDeServ",
          "SubTipServ",
          "RFCTerceroAutorizado",
          "FechaServ",
          "PrecioServSinIVA"
        ],
        "multiple": true,
        "ImpuestosTrasladadosdelServicio": {
          "attributes": [
            "Base",
            "Impuesto",
            "TipoFactor",
            "TasaCuota",
            "Importe"
          ]
        },
        "ContribucionGubernamental": {
          "attributes": [
            "ImpContrib",
            "EntidadDondePagaLaContribucion"
          ]
        },
        "ComisionDelServicio": {
          "attributes": [
            "Base",
            "Porcentaje",
            "Importe"
          ]
        }
      }
    }
  }
}

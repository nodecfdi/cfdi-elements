{
  "prefix": "ine",
  "xml-namespace": "http://www.sat.gob.mx/ine",
  "xml-schemalocation": "http://www.sat.gob.mx/sitio_internet/cfd/ine/ine11.xsd",
  "version-attribute": "Version",
  "version-value": "1.1",
  "root": {
    "name": "INE",
    "attributes": [
      "Version",
      "TipoProceso",
      "TipoComite",
      "IdContabilidad"
    ],
    "children": [
      {
        "name": "Entidad",
        "multiple": true,
        "attributes": [
          "ClaveEntidad",
          "Ambito"
        ],
        "children": [
          {
            "name": "Contabilidad",
            "multiple": true,
            "attributes": [
              "IdContabilidad"
            ]
          }
        ]
      }
    ]
  }
}

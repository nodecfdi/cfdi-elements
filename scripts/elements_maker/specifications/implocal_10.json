{
  "prefix": "implocal",
  "xml-namespace": "http://www.sat.gob.mx/implocal",
  "xml-schemalocation": "http://www.sat.gob.mx/sitio_internet/cfd/implocal/implocal.xsd",
  "version-attribute": "version",
  "version-value": "1.0",
  "root": {
    "name": "ImpuestosLocales",
    "attributes": [
      "version",
      "TotaldeRetenciones",
      "TotaldeTraslados"
    ],
    "children": [
      {
        "name": "RetencionesLocales",
        "multiple": true,
        "attributes": [
          "ImpLocRetenido",
          "TasadeRetencion",
          "Importe"
        ]
      },
      {
        "name": "TrasladosLocales",
        "multiple": true,
        "attributes": [
          "ImpLocTrasladado",
          "TasadeTraslado",
          "Importe"
        ]
      }
    ]
  }
}

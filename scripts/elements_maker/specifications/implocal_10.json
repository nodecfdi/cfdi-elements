{
  "prefix": "implocal",
  "xml-namespace": "http://www.sat.gob.mx/implocal",
  "xml-schemalocation": "http://www.sat.gob.mx/sitio_internet/cfd/implocal/implocal.xsd",
  "version-attribute": "version",
  "version-value": "1.0",
  "root-element": "ImpuestosLocales",
  "structure": {
    "attributes": [
      "version",
      "TotaldeRetenciones",
      "TotaldeTraslados"
    ],
    "RetencionesLocales": {
      "attributes": [
        "ImpLocRetenido",
        "TasadeRetencion",
        "Importe"
      ],
      "multiple": true
    },
    "TrasladosLocales": {
      "attributes": [
        "ImpLocTrasladado",
        "TasadeTraslado",
        "Importe"
      ],
      "multiple": true
    }
  }
}

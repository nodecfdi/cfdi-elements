{
  "name": "@nodecfdi/cfdi-elements",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@12.23.0",
  "description": "Librería de elementos y/o estructuras de datos que componen un cfdi",
  "author": "Fernando Isidro <luffynando@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/nodecfdi/cfdi-elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodecfdi/cfdi-elements.git"
  },
  "bugs": {
    "url": "https://github.com/nodecfdi/cfdi-elements/issues"
  },
  "keywords": [
    "cfdi",
    "elements",
    "xml",
    "structure",
    "cfdi40",
    "pagos20",
    "sat",
    "mx",
    "cartaporte",
    "implocal"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./cartaporte31": "./dist/cartaporte31.js",
    "./cce20": "./dist/cce20.js",
    "./cfdi40": "./dist/cfdi40.js",
    "./consumodecombustibles11": "./dist/consumodecombustibles11.js",
    "./dividendos10": "./dist/dividendos10.js",
    "./donat11": "./dist/donat11.js",
    "./iedu10": "./dist/iedu10.js",
    "./implocal10": "./dist/implocal10.js",
    "./ine11": "./dist/ine11.js",
    "./leyendasFisc10": "./dist/leyendasFisc10.js",
    "./nomina12": "./dist/nomina12.js",
    "./notariospublicos10": "./dist/notariospublicos10.js",
    "./pago20": "./dist/pago20.js",
    "./pagosaextranjeros10": "./dist/pagosaextranjeros10.js",
    "./plataformasTecnologicas10": "./dist/plataformasTecnologicas10.js",
    "./retenciones20": "./dist/retenciones20.js",
    "./servicioparcial10": "./dist/servicioparcial10.js",
    "./tfd11": "./dist/tfd11.js",
    "./types": "./dist/types.js",
    "./ventavehiculos11": "./dist/ventavehiculos11.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || ^24 || ^26"
  },
  "scripts": {
    "prepare": "is-in-ci || husky",
    "changelog": "auto-changelog -u -p",
    "commitlint": "commitlint --edit",
    "make:elements": "tsx scripts/make_elements.ts",
    "make:specification": "tsx scripts/make_specification.ts",
    "make:tests": "tsx scripts/make_tests.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tool:code": "pnpm run lint:check && pnpm run typecheck",
    "tool:build": "pnpm run tool:code && pnpm run test:run",
    "build": "tsdown",
    "release": "release-it"
  },
  "dependencies": {
    "@nodecfdi/cfdi-core": "^2.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eienjs/eslint-config": "^2.3.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.1",
    "auto-changelog": "^2.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "husky": "^9.1.7",
    "is-in-ci": "^2.0.0",
    "release-it": "^21.1.3",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  },
  "release-it": {
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): :tada: v${version}",
      "tagAnnotation": "chore(release): :tada: v${version}"
    },
    "github": {
      "release": true,
      "web": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "publish": true,
      "publishPackageManager": "pnpm",
      "publishArgs": [
        "--no-git-checks"
      ]
    },
    "hooks": {
      "before:init": [
        "pnpm run lint:check",
        "pnpm run typecheck",
        "pnpm test:run"
      ],
      "after:bump": [
        "pnpm run build",
        "pnpm run changelog"
      ]
    }
  }
}
